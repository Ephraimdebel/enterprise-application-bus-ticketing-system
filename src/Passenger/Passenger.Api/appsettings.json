{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PassengerDb": "Host=localhost;Port=5433;Database=passenger_db;Username=admin;Password=admin"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/bus-ticketing",
    "Audience": "passenger-api",
    "RequireAuth": false
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "passenger.events"
  },
  "OutboxProcessing": {
    "BatchSize": 50,
    "MaxAttempts": 10
  }
}